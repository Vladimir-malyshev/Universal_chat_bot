name: 🚀 Деплой по SSH

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: self-hosted

    steps:
      - name: 🧹 Обновляем код по SSH
        run: |
          cd /home/oteb/aibot
          
          git pull origin main

      - name: 🐍 Устанавливаем зависимости
        run: |
          cd /home/oteb/aibot
          ./venv/bin/pip install -r requirements.txt

      - name: 🔁 Перезапускаем сервис
        run: |
          sudo systemctl restart aibot
          sudo systemctl status aibot --no-pager || echo "❗ Сервис не запущен"
