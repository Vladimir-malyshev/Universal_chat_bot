# ==========================================
# Универсальный ИИ-Бот - Настройки окружения
# ==========================================

# 1. Настройки вебхуков MAX Messenger
# URL-адрес API мессенджера MAX для отправки сообщений
MAX_API_URL="https://api.max-messenger.com"
# Токен бота (вставьте свой реальный токен MAX)
MAX_API_TOKEN="your_max_bot_token_here"

# 2. Настройки ML-моделей (Распознавание речи)
# Токен HuggingFace, необходим для загрузки VAD модели pyannote/segmentation-3.0
# Получить можно здесь: https://huggingface.co/settings/tokens
HF_TOKEN="your_huggingface_access_token"

# 3. Дополнительные настройки (для LLM и других сервисов)
# Если используете старые сервисы TTS/LLM, раскомментируйте нужные:
# GOOGLE_API_KEY="your_google_gemini_key"
# OPENROUTER_API_KEY="your_openrouter_key"
# GROQ_API_KEY="your_groq_key"
